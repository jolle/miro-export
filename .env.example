# Copy this file to .env and fill in the values. .env is git-ignored.

# The value of the "token" cookie from a logged-in Miro session in a browser.
# Used as the default for --token / the `token` option.
MIRO_TOKEN=

# Only needed to run the integration tests against real boards.
TEST_BOARD_ID=
PRIVATE_TEST_BOARD_ID=
BUGGY_TEST_BOARD_ID=
